<form autocomplete="off">
    <div class="calendar-summary">
        <h2>{{calendarDisplay}}</h2>
        <p>Day key: {{calendarDayKey}}</p>
    </div>

    {{#if editable}}
        <div class="form-group">
            <label for="day">Day</label>
            <div class="form-fields">
                <input type="number" name="day" value="{{calendar.day}}" min="1" step="1" />
            </div>
        </div>

        <div class="form-group">
            <label for="month">Month</label>
            <div class="form-fields">
                <input type="number" name="month" value="{{calendar.month}}" min="1" step="1" />
            </div>
        </div>

        <div class="form-group">
            <label for="year">Year</label>
            <div class="form-fields">
                <input type="number" name="year" value="{{calendar.year}}" min="1" step="1" />
            </div>
        </div>

        <div class="form-group">
            <label for="hour">Hour</label>
            <div class="form-fields">
                <input type="number" name="hour" value="{{calendar.hour}}" min="0" max="23" step="1" />
            </div>
        </div>

        <div class="form-group buttons">
            <button type="submit">
                <i class="far fa-save"></i> Save
            </button>
        </div>
    {{else}}
        <p class="notes">Only the GM can edit the calendar.</p>
    {{/if}}
</form>